---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-6 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        <form
          id="game-filters"
          class="rounded-xl border border-slate-700 bg-slate-800/70 p-4"
          aria-label="Filter games"
          data-testid="game-filters"
        >
          <div class="flex flex-col gap-4 lg:flex-row lg:items-end">
            <fieldset>
              <legend class="mb-2 text-sm font-medium text-slate-200">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categories.map((category) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      name="category"
                      value={category.id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${category.id}`}
                    />
                    {category.name}
                  </label>
                ))}
              </div>
            </fieldset>

            <label class="flex flex-col gap-2 text-sm font-medium text-slate-200">
              <span>Publisher</span>
              <select
                name="publisher"
                class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                  <option value={publisher.id}>{publisher.name}</option>
                ))}
              </select>
            </label>

            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>
        </form>
      </div>

      <p class="mb-4 text-sm text-slate-400" aria-live="polite" data-testid="filter-status">
        Showing {games.length} games
      </p>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      <div hidden data-testid="filtered-empty-state">
        <EmptyState text="No games match the selected filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('#game-filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const status = document.querySelector<HTMLElement>('[data-testid="filter-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (form && status && emptyState) {
    const categoryInputs = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="category"]'),
    );
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const applyFilters = (updateUrl: boolean): void => {
      const selectedCategories = categoryInputs
        .filter((input) => input.checked)
        .map((input) => input.value);
      const selectedPublisher = publisherInput?.value ?? '';

      let visibleCount = 0;
      for (const card of cards) {
        const categoryMatches =
          selectedCategories.length === 0 ||
          selectedCategories.includes(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
        const visible = categoryMatches && publisherMatches;
        card.hidden = !visible;
        if (visible) {
          visibleCount += 1;
        }
      }

      emptyState.hidden = visibleCount > 0;
      status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;

      if (updateUrl) {
        const params = new URLSearchParams();
        for (const category of selectedCategories) {
          params.append('category', category);
        }
        if (selectedPublisher) {
          params.set('publisher', selectedPublisher);
        }
        const query = params.toString();
        history.replaceState(null, '', query ? `/?${query}` : '/');
      }
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    for (const input of categoryInputs) {
      input.checked = selectedCategories.has(input.value);
    }
    if (publisherInput) {
      publisherInput.value = params.get('publisher') ?? '';
    }

    form.addEventListener('change', () => applyFilters(true));
    form.addEventListener('reset', () => {
      requestAnimationFrame(() => applyFilters(true));
    });
    applyFilters(false);
  }
</script>
